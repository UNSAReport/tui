# TUI client overrides (used by unsarep)
UNSAREP_REGISTRY_URL=http://localhost:47001
UNSAREP_API_URL=http://localhost:47002
UNSAREP_TOKEN=

# Registry service (dev via docker compose)
DATABASE_URL=postgresql://registry:registrypassword@localhost:5432/registry_db
IDP_ISSUER=http://localhost:47002
IDP_JWKS_URL=http://localhost:47002/.well-known/jwks.json
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=unsareport-registry
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MAX_PENDING_PACKAGES=5

# Auth service (dev via docker compose)
AUTH_DATABASE_URL=postgresql://idp:idppassword@localhost:5432/idp_db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
IDP_PORT=3000
IDP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CLIENT_REDIRECT_URL=http://localhost:3000
ADMIN_API_KEY=admin-secret-key-12345
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
