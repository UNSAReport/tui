# TUI client overrides (used by unsarep) — dev single Traefik entrypoint http://localhost:9876
UNSAREP_REGISTRY_URL=http://localhost:9876/api/registry
UNSAREP_IDP_ISSUER=http://localhost:9876/api/auth
UNSAREP_WEBSITE_URL=http://localhost:9876
UNSAREP_TOKEN=

# Registry service (dev via docker compose) — mirrors prod ingress /api/registry strip
DATABASE_URL=postgresql://registry:registrypassword@localhost:5432/registry_db
IDP_ISSUER=http://localhost:9876/api/auth
IDP_JWKS_URL=http://localhost:9876/.well-known/jwks.json
PORT=3001
ALLOWED_ORIGINS=http://localhost:9876
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=unsareport-registry
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MAX_PENDING_PACKAGES=5

# Auth service (dev via docker compose) — IDP at http://localhost:9876/api/auth
AUTH_DATABASE_URL=postgresql://idp:idppassword@localhost:5432/idp_db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
IDP_PORT=3000
IDP_ALLOWED_ORIGINS=http://localhost:9876
CLIENT_REDIRECT_URL=http://localhost:9876
ADMIN_API_KEY=admin-secret-key-12345
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
